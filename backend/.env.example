# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Superusuario inicial (solo lo usa `manage.py bootstrap`)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
DJANGO_SUPERUSER_NOMBRE=Administrador

# Cookies (en producción sobre HTTPS dejar en True)
REFRESH_COOKIE_SECURE=False
