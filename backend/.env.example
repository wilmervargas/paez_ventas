# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Superusuario inicial (solo lo usa `manage.py bootstrap`)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
DJANGO_SUPERUSER_NOMBRE=Administrador

# Cookies (en producción sobre HTTPS dejar en True)
REFRESH_COOKIE_SECURE=False

# Correo (recuperación de contraseña y respaldos). En desarrollo se usa consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com

# URL del frontend (usada en enlaces de recuperación de contraseña).
FRONTEND_URL=http://localhost:5173

# Servidor local de WhatsApp (ws/server). Debe estar en ejecución para el
# envío directo; la sesión se vincula escaneando el QR en su consola.
WHATSAPP_WS_URL=http://127.0.0.1:3000
WHATSAPP_TIMEOUT=20
